# Copy this file to .env.local. Never commit .env.local.
# Browser/Vite variables are embedded into the test build, so restrict API keys in Google Cloud.

# Gemini Developer API key from Google AI Studio (AI topic generation, distractors, research, captions).
VITE_GEMINI_API_KEY=

# Optional: Google Cloud API key with Custom Search API and YouTube Data API v3 enabled.
# You can use the same restricted Google Cloud key for both search and YouTube.
VITE_GOOGLE_SEARCH_API_KEY=

# Optional: Programmable Search Engine ID (cx) with Image Search enabled.
VITE_GOOGLE_SEARCH_ENGINE_ID=
